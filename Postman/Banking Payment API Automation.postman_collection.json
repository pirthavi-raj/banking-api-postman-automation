          "name": "Account Details",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();\r\n\r\npm.test(\"Response contains user ID\", function () {\r\n    const response = pm.response.json();\r\n    pm.expect(response.id).to.exist;\r\n});\r\n\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response is JSON\", function () {\r\n    pm.response.to.be.json;\r\n});\r\n\r\npm.test(\"Account ID exists\", function () {\r\n    const response = pm.response.json();\r\n    pm.expect(response.id).to.exist;\r\n});\r\n\r\npm.test(\"Account ID is correct\", function () {\r\n    const response = pm.response.json();\r\n    pm.expect(response.id).to.eql(1);\r\n});\r\n\r\npm.test(\"Account name exists\", function () {\r\n    const response = pm.response.json();\r\n    pm.expect(response.name).to.not.be.empty;\r\n});\r\n\r\npm.test(\"Username is not empty\", function(){\r\n  pm.expect(response.name).to.be.a(\"string\");\r\n  pm.expect(response.name).to.not.be.empty;\r\n});\r\n\r\npm.test(\"Email property exists\", function(){\r\n   pm.expect(response).to.have.property(\"email\");\r\n});\r\n\r\n\r\npm.test(\"Response contains all required fields\", function(){\r\n   pm.expect(response).to.have.property(\"id\");\r\n   pm.expect(response).to.have.property(\"name\");\r\n   pm.expect(response).to.have.property(\"email\");\r\n});\r\n\r\npm.test(\"Email has a valid basic format\", function(){\r\n  pm.expect(response.email).to.match(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/);\r\n});\r\n\r\nconsole.log(\"Account response:\", response);\r\n\r\n"
                ]
              }
            }
