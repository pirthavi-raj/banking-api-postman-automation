    {
      "name": "Valid Payment",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "\r\nconst response = pm.response.json();\r\n\r\npm.test(\"Status is 201 created\", function(){\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Payment ID is present\", function(){\r\n    pm.expect(response.paymentId).to.be.a(\"string\");\r\n    pm.expect(response.paymentId).to.not.be.empty;\r\n});\r\n\r\npm.test(\"Payment status is activated\", function(){\r\n   pm.expect(response.status).to.eql(\"Accepted\");\r\n});\r\n\r\npm.test(\"Currency is Euro\", function(){\r\n    pm.expect(response.currency).to.eql(\"EUR\");\r\n});\r\n\r\n"
            ]
          }
        }
      ],
